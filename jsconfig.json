{
    "compilerOptions": {
        "checkJs"                    : true,
        "skipLibCheck"               : true,
        "maxNodeModuleJsDepth"       : 0,
        "jsx"                        : "react",
        "module"                     : "esNext",
        "target"                     : "esNext",
        "moduleResolution"           : "bundler",
        "noImplicitThis"             : false,
        "noImplicitAny"              : false,
        "strictNullChecks"           : false,
        "useUnknownInCatchVariables" : false,
        "paths"                      : {
            "*" : [
                "./src/*"
            ]
        }
    },
    "exclude": [
        "node_modules",
        "**/node_modules/*"
    ]
}
